{
  "name": "solosoul",
  "private": true,
  "version": "2.11.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen-nsis-assets && node scripts/build-search-index.js && node scripts/stage-mobile-resources.cjs && node scripts/stage-desktop-resources.cjs && tsc --noEmit && vite build",
    "gen-nsis-assets": "python3 scripts/generate-nsis-assets.py || python scripts/generate-nsis-assets.py",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "tauri:android:build:arm": "tauri android build --target aarch64 --target armv7 --apk",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build",
    "tauri:ios:build:sim": "tauri ios build --target aarch64-apple-ios-sim",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile",
    "check-all": "tsc --noEmit && cargo fmt --check && cargo clippy -- -D warnings && cargo test && npm run lint && npm run test && node scripts/check-markdown-chunk-boundary.mjs && python3 scripts/check_acl_consistency.py && python3 scripts/check_pref_keys_sync.py",
    "check:pref-keys": "python3 scripts/check_pref_keys_sync.py || python scripts/check_pref_keys_sync.py",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "html5-qrcode": "^2.3.8",
    "i18next": "^26.3.1",
    "lucide-react": "^1.17.0",
    "qrcode.react": "^4.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
