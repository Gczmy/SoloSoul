<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 生物识别凭证使用 Keychain UserPresence，需要声明 keychain-access-groups，
       否则 SecItemAdd 会返回 -34018 "A required entitlement isn't present"。 -->
  <key>keychain-access-groups</key>
  <array>
    <string>com.solosoul.app</string>
  </array>
</dict>
</plist>
